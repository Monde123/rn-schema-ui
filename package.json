{
  "name": "rn-formkit",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo rn-schema-ui \u2014 React Native form codegen from Zod / JSON Schema (iOS, Android, web via Expo)",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "build": "npm run build -w @rn-schema-ui/templates && npm run build -w @rn-schema-ui/runtime && npm run build -w rn-schema-ui",
    "cli": "node packages/cli/bin/rn-schema-ui.js",
    "generate:user": "node packages/cli/bin/rn-schema-ui.js generate ./schemas/user.ts --out ./example/app/\\(auth\\)/register --name Register",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:coverage": "npm test -- --coverage",
    "lint": "eslint packages --ext .ts,.tsx",
    "format": "prettier -w \"**/*.{ts,tsx,js,json,md}\"",
    "size": "npm run size -w @rn-schema-ui/runtime",
    "bench:generate": "node scripts/bench-generate.mjs",
    "typecheck": "tsc -p packages/templates/tsconfig.json --noEmit && tsc -p packages/runtime/tsconfig.json --noEmit && tsc -p packages/cli/tsconfig.json --noEmit",
    "format:check": "prettier -c \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml}\"",
    "quality": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run size && npm run bench:generate",
    "pack:dry": "node scripts/pack-dry.mjs"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.8.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.3.3",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-test-renderer": "18.3.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Mo\u00efse Koudanko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monde123/rn-schema-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Monde123/rn-schema-ui/issues"
  },
  "homepage": "https://github.com/Monde123/rn-schema-ui#readme"
}
