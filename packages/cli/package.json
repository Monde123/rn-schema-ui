{
  "name": "rn-schema-ui",
  "version": "0.1.0",
  "description": "Generate React Native form screens, validation wiring, UI states, and RNTL tests from a Zod or JSON Schema. iOS, Android, web (Expo).",
  "bin": {
    "rn-schema-ui": "./bin/rn-schema-ui.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ./scripts/bundle-templates.mjs && tsc -p tsconfig.json",
    "dev": "node ./bin/rn-schema-ui.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "jiti": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "react-native",
    "expo",
    "zod",
    "json-schema",
    "codegen",
    "forms",
    "cli",
    "react-native-web",
    "testing-library"
  ],
  "license": "MIT",
  "author": "Mo\u00efse Koudanko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monde123/rn-schema-ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Monde123/rn-schema-ui/issues"
  },
  "homepage": "https://github.com/Monde123/rn-schema-ui#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
