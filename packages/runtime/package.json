{
  "name": "rn-schema-ui-runtime",
  "version": "0.1.0",
  "description": "Thin runtime for rn-schema-ui generated screens: useForm (zod.safeParse), useField, Loading/Error/Empty/Success states. iOS, Android, web.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "size": "npm run build && node ./scripts/size.mjs && size-limit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@size-limit/file": "^11.2.0",
    "@types/react": "^18.3.12",
    "size-limit": "^11.2.0",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "size-limit": [
    {
      "path": "dist/*.js",
      "limit": "8 KB",
      "gzip": true
    }
  ],
  "author": "Mo\u00efse Koudanko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Monde123/rn-schema-ui.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/Monde123/rn-schema-ui/issues"
  },
  "homepage": "https://github.com/Monde123/rn-schema-ui#readme",
  "keywords": [
    "react-native",
    "expo",
    "zod",
    "forms",
    "react-native-web",
    "rn-schema-ui"
  ],
  "publishConfig": {
    "access": "public"
  }
}
